{
  "expo": {
    "name": "Teamora",
    "slug": "teamora-bootstrap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.teamora.fcrevalation",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F1117",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "teamora",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#22C55E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b752d247-981a-4a59-b593-0a210a1ebb86"
      }
    }
  }
}
